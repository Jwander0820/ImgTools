# Keep repository fixtures and UI assets even when their extensions match above.
!/tests/fixtures/
!/tests/fixtures/**
!/imgtools/ui/static/
!/imgtools/ui/static/**

# Documentation is source, not generated output.
!/docs/
!/docs/*.md
